# python
__pycache__/
*.py[cod]
.venv/
venv/

# backend runtime artifacts — regenerated on startup
Backend/poc.db
Backend/poc.db.backup-*
Backend/server.log
.env

# keep the uploads directory, never its contents
Backend/uploads/*
!Backend/uploads/.gitkeep

# images — scans, samples and screenshots stay out of git
*.png
*.jpg
*.jpeg
*.pdf
# except the Expo app icons; app.json references them by path and the build fails without them
!Mobile/assets/*.png

.claude/
.vscode/
# node / expo
node_modules/
.expo/
*.log

# built Vite console — regenerated by `npm run build`
FE/dist/
Sample/
*.md
!README.md
