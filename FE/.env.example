# FE/.env.example — copy to FE/.env before `npm run dev` / `npm run build`.
#
#   cp FE/.env.example FE/.env
#
# Vite only exposes variables prefixed VITE_. Read at build time, so change
# it and restart the dev server.

# Scan-with-phone: shows the "Scan with phone" QR option in the Add-document
# menu. Needs the Mobile/ Expo app running and the backend reachable on the
# LAN. AddDocumentMenu.jsx falls back to a plain "Upload files" button when
# this is anything other than "true".
VITE_ENABLE_PHONE_SCAN=true
