# Backend/.env.example — copy to Backend/.env and fill in.
#
#   cp Backend/.env.example Backend/.env
#
# Read by main.py's _load_dotenv() before anything else. A real environment
# variable set outside the file always wins over a value here.
# Backend/.env itself is gitignored; this template is not — keep real keys out.

# --- extraction ---------------------------------------------------------
# Which vision engine reads scanned documents: "anthropic" or "openai".
# extract.py defaults to "anthropic" if unset.
EXTRACT_PROVIDER=openai

# Credentials — only the one matching EXTRACT_PROVIDER is read.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides. Defaults: claude-opus-5 (anthropic) /
# gpt-4o-mini (openai) for the routine first pass.
# EXTRACT_MODEL=gpt-4o-mini

# What "Re-read this document" runs on. A re-read is rare and deliberate —
# someone has looked at a page the first pass got wrong — so it is worth a
# bigger model here even when routine extraction stays cheap.
# Defaults: claude-opus-5 (anthropic) / gpt-4o (openai).
# EXTRACT_MODEL_THOROUGH=gpt-4o
# How hard a re-read is told to think. Anthropic path only.
# EXTRACT_THOROUGH_THINKING=10000

# --- chatbot ------------------------------------------------------------
# "Purchase Bot" (chat.py). Defaults to "openai" and reuses OPENAI_API_KEY
# above — set to "groq" with GROQ_API_KEY to put it on a separate free-tier
# credential instead.
CHAT_PROVIDER=openai
# GROQ_API_KEY=gsk_...
# CHAT_MODEL=
# CHAT_BASE_URL=

# --- phone scanner ------------------------------------------------------
# HMAC signing key for scanner session tokens. The fallback baked into
# main.py is literally "dev-insecure-key" — replace this.
SECRET_KEY=replace-with-a-long-random-string

# Scanner session token lifetime, seconds.
SESSION_TTL=900

# LAN IP advertised inside the QR the phone scans. Leave commented to
# auto-detect; set it only on machines whose Docker/VM adapters confuse
# detection.
# HOST_IP=192.168.1.50

# Port advertised in the QR. Must match the port uvicorn is started on.
# PORT=8000

# --- PDF / OCR ----------------------------------------------------------
# PDF pages are rasterised before extraction.
# PDF_DPI=200
# PDF_MAX_PAGES=10
# Local OCR pre-pass (needs tesseract installed). Off by default.
# ENABLE_OCR=false
